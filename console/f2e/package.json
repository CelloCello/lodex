{
  "name": "lodex-console",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
